--- !u!114 &2953130882173776738
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6339937059727670953}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 64b523c65b8b68446a90cc533b7f9df5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Uraty.Application.Matching::Uraty.Feature.TemplateText.CreateTips
  _targetText: {fileID: 8969132401081379278}
  _templateTexts:
  - "\u30A2\u30BF\u30C3\u30AB\u30FC\u306F\u4E2D\u8DDD\u96E2\u306E\u653B\u6483\u30BF\u30A4\u30D7\u3060\uFF01\u524D\u306B\u51FA\u3066\u7A4D\u6975\u7684\u306B\u6575\u3092\u5012\u305D\u3046\uFF01"
  - "\u30A2\u30BF\u30C3\u30AB\u30FC\u306E\u597D\u304D\u306A\u30AC\u30E0\u306E\u30D5\u30EC\u30FC\u30D0\u30FC\u306F\u30D4\u30AF\u30EB\u30B9\u5473\u3089\u3057\u3044\u3002"
  - "\u30D5\u30A1\u30A4\u30BF\u30FC\u306F\u8FD1\u8DDD\u96E2\u7279\u5316\u306E\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u3060\uFF01\u306F\u3061\u307F\u3064\u3092\u7E8F\u3063\u305F\u624B\u3067\u653B\u6483\u3059\u308B\uFF01"
  - "\u30D5\u30A1\u30A4\u30BF\u30FC\u306F\u30E1\u30FC\u30D7\u30EB\u30B7\u30ED\u30C3\u30D7\u30A2\u30EC\u30EB\u30AE\u30FC\u3067\u98DF\u54C1\u6DFB\u52A0\u7269\u30A2\u30F3\u30C1\u3089\u3057\u3044\u3002"
  - "\u30B9\u30CA\u30A4\u30D1\u30FC\u306F\u9060\u8DDD\u96E2\u6700\u5F37\u306E\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u3060\uFF01\u72D9\u3063\u305F\u7372\u7269\u306F\u9003\u3055\u306A\u3044\uFF01"
  - "\u30B9\u30CA\u30A4\u30D1\u30FC\u306F\u30B3\u30AF\u30FB\u30B3\u30FC\u30E9\u3084\u30D1\u307A\u30B7\u3088\u308A\u30D3\u30AF\u30BF\u30FC\u30FB\u30DA\u30C3\u30DA\u30FC\u6D3E\u3060\u3002"
  - "\u30A2\u30B5\u30B7\u30F3\u306F\u8FD1\u8DDD\u96E2\u306E\u653B\u6483\u30BF\u30A4\u30D7\u3060\uFF01\u9699\u3092\u898B\u3066\u6575\u3092\u6697\u6BBA\u3057\u3088\u3046\uFF01"
  - "\u4E00\u5B9A\u6642\u9593\u653B\u6483\u305B\u305A\u30FB\u30C0\u30E1\u30FC\u30B8\u3092\u53D7\u3051\u305A\u306B\u3044\u308B\u3068\u81EA\u52D5\u7684\u306B\u56DE\u5FA9\u3059\u308B\u305E\uFF01"
  - "\u81EA\u52D5\u3067\u56DE\u5FA9\u3059\u308B\u305F\u3081\u306B\u6575\u304B\u3089\u8DDD\u96E2\u3092\u7F6E\u3044\u3066\u307F\u3088\u3046\uFF01"
  - "\u304A\u83D3\u5B50\u306E\u4E16\u754C\u3078\u3088\u3046\u3053\u305D\uFF01\u3053\u3053\u306F\u30B0\u30DF\u30D9\u30A2\u305F\u3061\u304C\u4F4F\u3080\u7518\u3044\u697D\u5712\u3060\uFF01"
  - "\u30B0\u30DF\u30D9\u30A2\u306F\u304A\u5C3B\u304C\u7279\u306B\u5927\u304D\u3044\u500B\u4F53\u304C\u6A29\u529B\u3092\u63E1\u308B\u4FEE\u6B63\u3092\u6301\u3063\u3066\u3044\u308B\u3002"
  - "\u30B0\u30DF\u30D9\u30A2\u306E\u751F\u307E\u308C\u305F\u7406\u7531\u3084\u5834\u6240\u306F\u3001\u672C\u4EBA\u305F\u3061\u3082\u77E5\u3089\u306A\u3044\u3002"
  _displayOnStart: 1
